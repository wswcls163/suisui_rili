  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.0",
    "fake-indexeddb": "^6.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:storage": "tsx --test tests/storage.test.ts tests/sync.integration.ts tests/supabase.integration.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:web": "expo export --platform web",
    "build:bundles": "expo export --platform android --platform ios --output-dir dist-native",
    "verify:calendar": "tsx scripts/verify-calendar.ts",
    "verify:layout": "tsx scripts/verify-responsive-layout.ts",
    "format": "prettier --write app src tests scripts *.json *.js",
    "format:check": "prettier --check app src tests scripts *.json *.js"
  },
  "private": true
}
